# Copy to .env (`make env` does this). .env is git-ignored: secrets never go in git (D14).

# --- Object storage: the data lake -------------------------------------------------------
# Local: RustFS, an S3-compatible server running in Docker Compose.
# AWS:   leave S3_ENDPOINT empty and use real keys, or leave the keys empty too to use the
#        IAM role of the machine/container (no long-lived keys, D29). See docs/AWS.md.
# The values below are local-only defaults: safe because every port listens on 127.0.0.1 (D27).
S3_ENDPOINT=http://objectstore:9000
S3_BUCKET=pk-ecommerce
AWS_ACCESS_KEY_ID=lakeadmin
AWS_SECRET_ACCESS_KEY=lakeadmin-secret
AWS_REGION=us-east-1

# --- Warehouse: Postgres ------------------------------------------------------------------
PGHOST=postgres
PGPORT=5432
PGUSER=pipeline
PGPASSWORD=pipeline
PGDATABASE=warehouse
# Cloud database (e.g. Amazon RDS): uncomment to require TLS for psycopg and JDBC.
# PGSSLMODE=require

# --- Pipeline -----------------------------------------------------------------------------
RAW_FILE=data/raw/pakistan_ecommerce.csv
SPARK_DRIVER_MEMORY=2g
